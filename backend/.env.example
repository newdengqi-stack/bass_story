# Internal-only. Secrets stay on the backend; never use VITE_* for them.
AI_MODE=mock
# To test a real domestic model: AI_MODE=dashscope, then supply your Beijing-region key.
DASHSCOPE_API_KEY=
AI_MODEL=qwen-plus
# Alternative: AI_MODE=deepseek, DEEPSEEK_API_KEY=<local secret>, AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=4096
ANALYSIS_REQUESTS_PER_MINUTE=6
